{
  "kit": "DXRHubAB",
  "kitVersion": "0.2.0",
  "issue": "#2317 P1d",
  "windowSeconds": 20,
  "warmupSeconds": 6,
  "reps": 3,
  "cooldownSeconds": 5,
  "startupTimeoutSec": 60,
  "noWitnessSettleSec": 12,
  "appDir": "..\\..\\test_apps\\build\\bin",
  "baseEnv": {
    "DXR_FRAME_WITNESS": "5",
    "VK_LOADER_LAYERS_DISABLE": "*"
  },
  "topologies": {
    "default": {},
    "same-adapter": {
      "DXR_D3D_FORCE_GPU": "scanout",
      "DXR_VK_FORCE_GPU": "scanout"
    }
  },
  "paths": {
    "native": "per-API in-process compositor weaves + presents (no output-device split, no hub)",
    "fill-arm": "D3D11 fill arm (comp_vk_native_split): #1264 d3d12 reroute or the VK output-device split",
    "own-split": "the API's own #918 output-device split (d3d12 own legs / d3d11 own split) - NOT the hub",
    "hub": "comp_hub_d3d11 in-process shim (DXR_HUB=1, P1b) - 'hub placement: hub=1'"
  },
  "apps": [
    {
      "name": "d3d11",
      "exe": "cube_handle_d3d11_win.exe",
      "nativeSite": "d3d11",
      "arms": [
        {
          "name": "native",
          "env": {},
          "expectPath": "own-split",
          "topologies": [
            "default"
          ]
        },
        {
          "name": "hub",
          "env": {
            "DXR_HUB": "1"
          },
          "expectPath": "hub",
          "topologies": [
            "default"
          ],
          "expectLine": "hub placement: hub=1 .*ingress=xbridge"
        },
        {
          "name": "native",
          "env": {},
          "expectPath": "own-split",
          "topologies": [
            "same-adapter"
          ]
        },
        {
          "name": "hub-direct",
          "env": {
            "DXR_HUB": "1"
          },
          "expectPath": "hub",
          "topologies": [
            "same-adapter"
          ],
          "expectLine": "hub placement: hub=1 .*ingress=direct"
        },
        {
          "name": "hub-xbridge",
          "env": {
            "DXR_HUB": "1",
            "DXR_HUB_INGRESS": "xbridge"
          },
          "expectPath": "hub",
          "topologies": [
            "same-adapter"
          ],
          "expectLine": "hub placement: hub=1 .*ingress=xbridge"
        },
        {
          "name": "kill-switch",
          "env": {
            "DXR_WEAVE_ON_SCANOUT": "0"
          },
          "expectPath": "native",
          "optional": true
        }
      ]
    },
    {
      "name": "d3d12",
      "exe": "cube_handle_d3d12_win.exe",
      "nativeSite": "d3d12",
      "arms": [
        {
          "name": "native",
          "env": {},
          "expectPath": "own-split",
          "topologies": [
            "default"
          ]
        },
        {
          "name": "hub",
          "env": {
            "DXR_SPLIT_D3D12_HYBRID_REROUTE": "1"
          },
          "expectPath": "fill-arm",
          "topologies": [
            "default"
          ],
          "expectLine": "heavy-d3d12 reroute ACTIVE",
          "optional": true,
          "note": "Code gate (comp_d3d12_compositor.cpp reroute_topology_ok): a HYBRID reroute needs DXR_SPLIT_D3D12_HYBRID_REROUTE=1 AND DXR_APP_FRAME_DIVISOR>=2, which halves the app's frame rate - not a like-for-like arm. Run with -Arms native,hub to see the refusal."
        },
        {
          "name": "native",
          "env": {
            "DXR_WEAVE_ON_SCANOUT": "0"
          },
          "expectPath": "native",
          "topologies": [
            "same-adapter"
          ]
        },
        {
          "name": "hub",
          "env": {},
          "expectPath": "fill-arm",
          "topologies": [
            "same-adapter"
          ],
          "expectLine": "heavy-d3d12 reroute ACTIVE"
        },
        {
          "name": "own-split",
          "env": {
            "DXR_SPLIT_D3D12_ROUTE": "own"
          },
          "expectPath": "own-split",
          "optional": true
        },
        {
          "name": "kill-switch",
          "env": {
            "DXR_WEAVE_ON_SCANOUT": "0"
          },
          "expectPath": "native",
          "topologies": [
            "default"
          ],
          "optional": true
        }
      ]
    },
    {
      "name": "vk",
      "exe": "cube_handle_vk_win.exe",
      "nativeSite": "vk",
      "arms": [
        {
          "name": "native",
          "env": {
            "DXR_WEAVE_ON_SCANOUT": "0"
          },
          "expectPath": "native"
        },
        {
          "name": "hub",
          "env": {},
          "expectPath": "fill-arm",
          "expectLine": "VK output-device split ACTIVE"
        }
      ]
    },
    {
      "name": "gl",
      "exe": "cube_handle_gl_win.exe",
      "nativeSite": "gl",
      "arms": [
        {
          "name": "native",
          "env": {},
          "expectPath": "native",
          "placementRequired": false,
          "witnessRequired": false
        }
      ]
    }
  ],
  "maxRetries": 3,
  "armNotes": "An arm runs only on the topologies it lists (absent = all). 'native' = the path main takes BY DEFAULT on that topology (VK: the kill switch, its only non-hub path). expectLine = an extra regex the app log must match."
}
