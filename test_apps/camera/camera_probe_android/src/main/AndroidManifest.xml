<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Same loader / runtime visibility as cube_handle_vk_android (see its manifest). -->
    <queries>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <provider
            android:authorities="org.khronos.openxr.runtime_broker"
            tools:replace="android:authorities" />
        <package android:name="org.freedesktop.monado.openxr_runtime.in_process" />
        <package android:name="org.freedesktop.monado.openxr_runtime.out_of_process" />
        <intent>
            <action android:name="org.freedesktop.monado.ipc.CONNECT" />
        </intent>
    </queries>
    <!-- A camera consumer must itself hold CAMERA (the runtime checks the peer, spec §7 Android). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="false" android:label="DisplayXR Camera Probe">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
