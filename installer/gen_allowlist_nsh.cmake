#
# Generates Allowlist.nsh for DisplayXRInstaller.nsi: the ADR-054 N4b provenance
# allowlist rows for the plug-in DLL(s) this installer ships.
#
# The provenance gate ENFORCES by default on Windows (PR B): a plug-in binary
# must be Authenticode-signed or have its SHA-256 under
# HKLM\Software\DisplayXR\Trust\Allowlist, or the loader refuses it. A signed
# release passes on the signature alone; an unsigned build (CI, a dev
# `build_windows.bat installer`, a release the signing provider missed) would
# otherwise install a sim-display the runtime then refuses — no DP at all. So
# the installer writes the digest of exactly the bytes it ships, computed here
# at packaging time, and the uninstaller removes the same rows.
#
# Invoked by installer/CMakeLists.txt as a pre-step of the `installer` target:
#   cmake -DBIN_DIR=<_package/bin> -DVERSION=<x.y.z> -DOUT=<Allowlist.nsh> -P gen_allowlist_nsh.cmake

if(NOT DEFINED BIN_DIR OR NOT DEFINED OUT)
	message(FATAL_ERROR "gen_allowlist_nsh.cmake: BIN_DIR and OUT are required")
endif()
if(NOT DEFINED VERSION)
	set(VERSION "dev")
endif()

# Keep in sync with the `File "${BIN_DIR}\plugins\..."` lines of the .nsi.
set(_shipped_plugins
	"${BIN_DIR}/plugins/DisplayXR-SimDisplay.dll"
	"${BIN_DIR}/plugins/DisplayXR-SimInput.dll"
	"${BIN_DIR}/plugins/DisplayXR-Gamepad.dll"
	"${BIN_DIR}/plugins/DisplayXR-SimConversion.dll"
	# Shipped unregistered (no TrackingProviders row): allowlisted so a row a
	# developer adds by hand is admitted by the enforcing gate.
	"${BIN_DIR}/plugins/DisplayXR-SimTracking.dll"
)

set(_write "")
set(_remove "")
foreach(_dll IN LISTS _shipped_plugins)
	if(NOT EXISTS "${_dll}")
		message(FATAL_ERROR "gen_allowlist_nsh.cmake: shipped plug-in missing: ${_dll}")
	endif()
	file(SHA256 "${_dll}" _hex)
	get_filename_component(_name "${_dll}" NAME)
	string(APPEND _write
		"\tWriteRegStr HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\" \"${_name} (DisplayXR runtime installer ${VERSION})\"\n")
	string(APPEND _remove
		"\tDeleteRegValue HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\"\n")
	message(STATUS "allowlist: ${_name} sha256=${_hex}")
endforeach()

file(WRITE "${OUT}"
	"; Auto-generated by installer/gen_allowlist_nsh.cmake — do not edit.\n"
	"; ADR-054 N4b provenance allowlist rows for the plug-in DLL(s) this installer ships.\n"
	"!macro DXR_ALLOWLIST_WRITE\n"
	"${_write}"
	"!macroend\n"
	"!macro DXR_ALLOWLIST_REMOVE\n"
	"${_remove}"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\\Allowlist\"\n"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\"\n"
	"!macroend\n")
