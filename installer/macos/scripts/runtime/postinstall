#!/bin/bash
# Post-install: register DisplayXR as the active OpenXR runtime (system-wide).
#
# The active_runtime.json must be written everywhere the macOS OpenXR loader
# looks, otherwise default discovery (apps launched without XR_RUNTIME_JSON)
# won't find the freshly-installed runtime:
#   - /etc/xdg/openxr/1            XDG_CONFIG_DIRS default
#   - /usr/local/share/openxr/1    the loader's datadir (<prefix>/share/openxr/N
#                                   for prefix=/usr/local — the Khronos SDK
#                                   loaders bundled with the demo .apps read
#                                   here; mirrors MANIFEST_RELATIVE_DIR in
#                                   src/xrt/targets/openxr/CMakeLists.txt)
# Registering only /etc/xdg left default discovery resolving a stale symlink in
# the datadir (left by a prior `make install`), or failing outright (#385).
#
# `ln -sfn` overwrites any pre-existing file/symlink at the target, so this also
# self-heals a stale datadir symlink from an earlier dev `make install`.
INSTALL_DIR="/Library/Application Support/DisplayXR"
MANIFEST="$INSTALL_DIR/openxr_displayxr.json"

register_active_runtime() {
    local dir="$1"
    mkdir -p "$dir"
    ln -sfn "$MANIFEST" "$dir/active_runtime.json"
}

register_active_runtime /etc/xdg/openxr/1
register_active_runtime /usr/local/share/openxr/1

# Auto-start the DisplayXR service (macOS spatial shell, #61). The LaunchAgent
# has RunAtLoad so it starts at the next login regardless; bootstrapping it into
# the console user's GUI domain here also brings it up immediately after install
# (no logout needed). postinstall runs as root, so we target gui/<console-uid>.
# Skipped cleanly on a runtime-only (non-service) .pkg where the agent is absent.
AGENT="/Library/LaunchAgents/com.displayxr.service.plist"
if [ -f "$AGENT" ]; then
    CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
    if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
        CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null || true)"
        if [ -n "$CONSOLE_UID" ]; then
            # bootout first so a re-install reloads the new plist (idempotent).
            launchctl bootout "gui/$CONSOLE_UID" "$AGENT" 2>/dev/null || true
            launchctl bootstrap "gui/$CONSOLE_UID" "$AGENT" 2>/dev/null || true
            launchctl enable "gui/$CONSOLE_UID/com.displayxr.service" 2>/dev/null || true
            # Background Task Management can refuse the agent without telling
            # anyone: bootstrap returns 0, nothing is registered, and sfltool
            # shows the item as [enabled, disallowed, not notified]. An
            # installer cannot allow it, so point the user at the switch
            # (System Settings > General > Login Items > Allow in the Background).
            if ! launchctl print "gui/$CONSOLE_UID/com.displayxr.service" >/dev/null 2>&1; then
                echo "DisplayXR: the service LaunchAgent did not load; Background Task Management likely disallows it. Opening Login Items settings."
                launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" \
                    open "x-apple.systempreferences:com.apple.LoginItems-Settings.extension" 2>/dev/null || true
            fi
        fi
    fi
fi

# displayxr-cli on the PATH. The name is ours: an older dev `make install` copy
# at the same path is replaced.
if [ -x "$INSTALL_DIR/bin/displayxr-cli" ]; then
    mkdir -p /usr/local/bin
    ln -sfn "$INSTALL_DIR/bin/displayxr-cli" /usr/local/bin/displayxr-cli
fi

# displayxr:// URL scheme (ADR-064 §5): register the handler bundle with
# Launch Services so a displayxr://activate link opens it. The Launch Services
# database is PER USER and nothing scans the runtime's bin/ directory, so this
# line covers exactly one case: the user at the console right now, without a
# logout. It does nothing for any other user, for an install with nobody
# logged in (MDM, ssh), or after the database is rebuilt. Those are covered by
# displayxr-service, which re-registers the bundle for its own user at every
# start (service_url_scheme_macos.c; the LaunchAgent starts it in each GUI
# session). A runtime-only .pkg has no service: there, only this line
# registers the scheme (activation-deep-link.md §8, known limitation).
ACTIVATE_APP="$INSTALL_DIR/bin/DisplayXRActivate.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [ -d "$ACTIVATE_APP" ] && [ -x "$LSREGISTER" ]; then
    ACT_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
    if [ -n "$ACT_USER" ] && [ "$ACT_USER" != "root" ]; then
        ACT_UID="$(id -u "$ACT_USER" 2>/dev/null || true)"
        [ -n "$ACT_UID" ] && launchctl asuser "$ACT_UID" sudo -u "$ACT_USER" "$LSREGISTER" -f "$ACTIVATE_APP" >/dev/null 2>&1 || true
    fi
fi

# Desktop-capture helper (#2264): load its on-demand agent into the console
# user's GUI domain now so the Mach service exists without a logout. Loading
# does not start the helper (no RunAtLoad), and so does not prompt for Screen
# Recording; that happens only when a transparent session first needs it.
CAPTURE_AGENT="/Library/LaunchAgents/com.displayxr.desktop-capture.plist"
if [ -f "$CAPTURE_AGENT" ]; then
    CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
    if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
        CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null || true)"
        if [ -n "$CONSOLE_UID" ]; then
            launchctl bootout "gui/$CONSOLE_UID/com.displayxr.desktop-capture" 2>/dev/null || true
            pkill -x DisplayXRDesktopCapture 2>/dev/null || true
            launchctl bootstrap "gui/$CONSOLE_UID" "$CAPTURE_AGENT" 2>/dev/null || true
        fi
    fi
fi

exit 0
