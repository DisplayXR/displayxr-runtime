<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Component styles for every page. Values come from Styles/Theme.axaml
         through DynamicResource; nothing here names a colour. Classes:
         h1 / sub / group / label / value / mono / meta / desc / soft / dim /
         empty on TextBlock; card / notice / field / rule on Border; primary /
         quiet / outline / link / sm / danger on Button; nav on RadioButton. -->

    <!-- ── Type ─────────────────────────────────────────────────────────── -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.2"/>
    </Style>
    <Style Selector="TextBlock.sub">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.group">
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.6"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="TextBlock.dev">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.meta">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.desc">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style Selector="TextBlock.soft">
        <Setter Property="Foreground" Value="{DynamicResource SoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.empty">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>

    <!-- ── Buttons ──────────────────────────────────────────────────────── -->

    <Style Selector="Button">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadius}"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
    </Style>
    <Style Selector="Button:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button:disabled /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#06101F"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SoftBrush}"/>
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
    </Style>
    <Style Selector="Button.quiet:disabled /template/ Border#Root">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.outline">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
    </Style>
    <Style Selector="Button.outline:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
    </Style>

    <Style Selector="Button.warn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
    </Style>
    <Style Selector="Button.warn:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource WarnFillBrush}"/>
    </Style>

    <Style Selector="Button.sm">
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.link:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
    </Style>

    <!-- A string content becomes a TextBlock, and the TextBlock style above
         beats the colour the Button hands down: name the label colour per
         button class on the label itself. -->
    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground" Value="#06101F"/>
    </Style>
    <Style Selector="Button.warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
    </Style>
    <Style Selector="Button.quiet TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SoftBrush}"/>
    </Style>
    <Style Selector="Button.link TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
    <Style Selector="Button.link:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
    </Style>
    <Style Selector="Button:disabled TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
    </Style>

    <!-- The window's caption buttons (minimise / maximise / close over the
         extended client area) are Buttons too: give them back a flat,
         Windows-like look instead of the page button above. -->
    <Style Selector="CaptionButtons /template/ Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource SoftBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="CaptionButtons /template/ Button:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
    </Style>
    <Style Selector="CaptionButtons /template/ Button#PART_CloseButton:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="#C42B1C"/>
    </Style>

    <!-- ── Surfaces ─────────────────────────────────────────────────────── -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}"/>
        <Setter Property="Padding" Value="22,20"/>
    </Style>
    <Style Selector="Border.field">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource FieldRadius}"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource FieldRadius}"/>
        <Setter Property="Padding" Value="16,11"/>
    </Style>
    <Style Selector="Border.notice.warn">
        <Setter Property="Background" Value="{DynamicResource WarnFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
    </Style>
    <Style Selector="Border.notice.critical">
        <Setter Property="Background" Value="{DynamicResource CriticalFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}"/>
    </Style>
    <Style Selector="Border.rule">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <!-- ── Nav rail ─────────────────────────────────────────────────────── -->

    <Style Selector="RadioButton.nav">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="NavRoot" Background="{TemplateBinding Background}"
                        CornerRadius="8" Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalContentAlignment="Center"
                                      HorizontalContentAlignment="Stretch"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Padding" Value="14,0,10,0"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="12,2"/>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#NavRoot">
        <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SoftBrush}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#NavRoot">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
    </Style>

    <!-- Option radios (Performance): Fluent's, recoloured to the palette. -->
    <Style Selector="RadioButton.option">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="ComboBox.field">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource FieldRadius}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SoftBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="MaxWidth" Value="420"/>
    </Style>
</Styles>
