<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Copyright 2020, Collabora, Ltd.
        SPDX-License-Identifier: BSL-1.0
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application>
        <!--
            XR_DXR_stereo_camera A2: the runtime-owned 3D camera consent dialog
            (and the runtime's own CAMERA permission request). NOT exported:
            only the runtime's processes start it, and its answer goes back
            through the requester's ResultReceiver, so no other app can show
            or answer it. Translucent, out of recents, its own task.
        -->
        <activity
            android:name="org.freedesktop.monado.ipc.CameraConsentActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!--
            adb surface for the stored 3D camera decisions (list / revoke /
            revoke-all; StereoCameraConsentStore). Exported to the shell only:
            the sender must hold android.permission.DUMP, which adb's shell
            has and no third-party app can.
        -->
        <receiver
            android:name="org.freedesktop.monado.ipc.StereoCameraConsentStore$Receiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.displayxr.stereo_camera.CONSENT" />
            </intent-filter>
        </receiver>

        <service
            android:name="org.freedesktop.monado.ipc.MonadoService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="connectedDevice|mediaPlayback">

            <intent-filter>
                <action android:name="${serviceActionName}" />
                <action android:name="${shutdownActionName}" />
            </intent-filter>
        </service>

        <!--
            The satellite compositor-slot broker (ADR-036 D3, #1031). Lives in
            the APK's MAIN process, loads no native code and starts no runtime
            server; it only decides which satellite a client gets. Bound by
            explicit ComponentName from Client.java, so no intent-filter.
        -->
        <service
            android:name="org.freedesktop.monado.ipc.SlotBrokerService"
            android:enabled="true"
            android:exported="true" />

        <!--
            Satellite compositor slots (ADR-036 D3, #1031). One android:process
            each, so every bound client gets its own runtime process running the
            ordinary out-of-process compositor for exactly one client (own
            comp_multi, own android_globals surface, own display processor, own
            vendor core).

            NOT android:isolatedProcess — an isolated process cannot reach
            SurfaceFlinger or gralloc and therefore could never present.

            No intent-filter: clients bind by explicit ComponentName after the
            broker names the slot, which is also what keeps the runtime broker /
            RuntimeService / MonadoService in the main process untouched.

            Same foregroundServiceType as MonadoService above, but a satellite
            does NOT call startForeground() (RuntimeForegroundPolicy): it lives by
            its client's binding, and a foreground service anywhere in the
            runtime uid while the client is in the background parks the uid at
            AppOps "fgsvc" without the camera capability, which holds the camera
            refused for the 5 s settle after the client returns. The type stays
            declared for the debug.dxr.fgs_idle_only=0 kill switch. Never
            "camera": the OS while-in-use rule stays the backstop of the
            runtime's own foreground rule (XR_DXR_stereo_camera §7.2).

            THE COUNT IS CHECKED: :src:xrt:ipc:checkSatelliteSlotManifest fails
            the build if these entries disagree with dxrSatelliteSlots in
            build.gradle.
        -->
        <service
            android:name="org.freedesktop.monado.ipc.MonadoServiceSlot0"
            android:enabled="true"
            android:exported="true"
            android:process=":dxr0"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />
        <service
            android:name="org.freedesktop.monado.ipc.MonadoServiceSlot1"
            android:enabled="true"
            android:exported="true"
            android:process=":dxr1"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />
        <service
            android:name="org.freedesktop.monado.ipc.MonadoServiceSlot2"
            android:enabled="true"
            android:exported="true"
            android:process=":dxr2"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />
        <service
            android:name="org.freedesktop.monado.ipc.MonadoServiceSlot3"
            android:enabled="true"
            android:exported="true"
            android:process=":dxr3"
            android:foregroundServiceType="connectedDevice|mediaPlayback" />
    </application>
</manifest>
