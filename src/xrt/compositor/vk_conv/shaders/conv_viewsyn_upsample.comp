//
// ADR-053 S5, pass 5 (UPSAMPLE_FRAG): joint-bilateral upsample (Kopf 4x4) +
// EDGE SNAP. Port of k_viewsyn_upsample_ps; the output keeps only `.r` (the
// D3D11 stage's R16F raster), stored in an RGBA16F image.
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D t_dlo;   // r = u, g = min-filtered, b = max-filtered; row 0 = top
layout(set = 0, binding = 1) uniform sampler2D t_guide; // depth-res colour
layout(set = 0, binding = 2) uniform sampler2D t_color; // row 0 = top
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D o_dst;

layout(push_constant) uniform Up
{
	vec2 out_res;
	float sigma_s; // low-res px
	float sigma_r; // RGB 0..1
	int snap;
	int snap_r;     // <= 12
	float snap_tau; // normalised units
	float pad0;
}
pc;

void
store(ivec2 p, float v)
{
	imageStore(o_dst, p, vec4(v, 0.0, 0.0, 1.0));
}

void
main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (p.x >= int(pc.out_res.x) || p.y >= int(pc.out_res.y)) {
		return;
	}
	ivec2 lsz = textureSize(t_dlo, 0);
	vec2 lo = vec2(lsz);
	ivec2 loI = lsz - 1;
	vec2 xy = (vec2(p) + 0.5) / pc.out_res; // 0..1, y from the TOP
	vec3 c0 = textureLod(t_color, xy, 0.0).rgb;
	vec2 pl = xy * lo - 0.5;
	vec2 b = floor(pl);
	float inv2s = 1.0 / (2.0 * pc.sigma_s * pc.sigma_s);
	float inv2r = 1.0 / (2.0 * pc.sigma_r * pc.sigma_r);
	float sw = 0.0, sd = 0.0;
	for (int j = -1; j <= 2; j++) {
		for (int i = -1; i <= 2; i++) {
			ivec2 s = clamp(ivec2(b) + ivec2(i, j), ivec2(0), loI);
			vec2 dd = vec2(s) - pl;
			float ws = exp(-dot(dd, dd) * inv2s);
			vec3 dc = texelFetch(t_guide, s, 0).rgb - c0;
			float w = ws * (exp(-dot(dc, dc) * inv2r) + 1e-3);
			sw += w;
			sd += w * texelFetch(t_dlo, s, 0).r;
		}
	}
	float dj = sd / sw;
	if (pc.snap == 0) {
		store(p, dj);
		return;
	}

	vec3 here = textureLod(t_dlo, (pl + 0.5) / lo, 0.0).rgb;
	float dmax = here.b, dmin = here.g;
	float rng = dmax - dmin;
	float eW = smoothstep(pc.snap_tau, 2.0 * pc.snap_tau, rng);
	if (eW <= 0.0) {
		store(p, dj);
		return;
	}
	float th = 0.25 * rng;
	ivec2 ci = ivec2(floor(pl + 0.5));
	float R = float(pc.snap_r);
	float inv2c = 1.0 / (2.0 * 0.36 * R * R);

	vec3 sf = vec3(0.0), sb = vec3(0.0);
	float nf = 0.0, nb = 0.0, df = 0.0, db = 0.0;
	for (int jj = -12; jj <= 12; jj++) {
		if (abs(jj) > pc.snap_r) {
			continue;
		}
		for (int ii = -12; ii <= 12; ii++) {
			if (abs(ii) > pc.snap_r) {
				continue;
			}
			ivec2 s = clamp(ci + ivec2(ii, jj), ivec2(0), loI);
			vec2 dd = vec2(ci + ivec2(ii, jj)) - pl;
			float w = exp(-dot(dd, dd) * inv2c) * clamp(R - length(dd), 0.0, 1.0);
			vec3 t = texelFetch(t_dlo, s, 0).rgb;
			vec3 g = texelFetch(t_guide, s, 0).rgb;
			float wf = w * smoothstep(dmax - 2.0 * th, dmax - 0.5 * th, t.g);
			float wb = w * (1.0 - smoothstep(dmin + 0.5 * th, dmin + 2.0 * th, t.b));
			sf += wf * g;
			df += wf * t.r;
			nf += wf;
			sb += wb * g;
			db += wb * t.r;
			nb += wb;
		}
	}
	float conf = smoothstep(0.05, 0.4, min(nf, nb));
	if (conf <= 0.0) {
		store(p, dj);
		return;
	}
	vec3 cf = sf / nf, cb = sb / nb;
	vec3 ab = cf - cb;
	float l2 = dot(ab, ab);
	float sep = smoothstep(0.005, 0.02, l2);
	if (sep <= 0.0) {
		store(p, dj);
		return;
	}
	float aC = clamp(dot(c0 - cb, ab) / l2, 0.0, 1.0);
	float aM = clamp((dj - dmin) / rng, 0.0, 1.0);
	float a = smoothstep(0.3, 0.7, mix(aC, aM, 0.2));
	float ds = mix(db / nb, df / nf, a);
	store(p, mix(dj, ds, eW * sep * conf));
}
