<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Per-monitor-v2 DPI awareness, shared by every DisplayXR executable
  (displayxr-cli, displayxr-service, displayxr-control-panel).

  Without it Windows hands the process VIRTUALISED coordinates: on a 4K panel
  at 150% scaling every GDI query — EnumDisplayMonitors rects, GetMonitorInfo,
  GetClientRect/ClientToScreen — answers 2560x1440, and the runtime's EDID
  enumerator, the panel geometry it feeds the display processor, and the
  weave phase computed from window coordinates are all off by the scale
  factor (issue #1201).

  A manifest is the primary mechanism because it is in force before any code
  runs, including static initialisers and DllMain; u_win_make_process_dpi_aware()
  is the toolchain-independent backstop for builds that cannot embed one.

  The DisplayXR test apps carry the same two settings in their own manifests.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
