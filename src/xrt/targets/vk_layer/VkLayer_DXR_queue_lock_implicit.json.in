{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_DXR_queue_lock",
        "type": "GLOBAL",
        "library_path": "@DXR_QL_LIBRARY_PATH@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "DisplayXR per-queue submit serialization for the late-weave repaint on single-graphics-queue GPUs (#902); implicit, opt-in with DXR_VK_QUEUE_LOCK=1 for vulkan_enable1 apps (#886)",
        "enable_environment": {
            "DXR_VK_QUEUE_LOCK": "1"
        },
        "disable_environment": {
            "DXR_VK_QUEUE_LOCK_DISABLE": "1"
        }
    }
}
